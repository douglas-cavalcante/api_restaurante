# Copie este arquivo para ".env" e preencha com valores reais.
# Nunca commite o ".env" de verdade (ele já está no .gitignore).

# DB_HOST: use "postgres" quando rodar via docker-compose (nome do serviço),
# ou "localhost" quando rodar a API direto na máquina (npm start).
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque-esta-senha
DB_NAME=restaurante

# Use um segredo forte e aleatório em produção (ex: openssl rand -hex 32).
JWT_SECRET=troque-este-segredo

PORT=8888

# Amazon S3 (upload de arquivos)
# Crie um usuario IAM com permissao s3:PutObject, s3:GetObject e s3:DeleteObject
# apenas no bucket abaixo e gere uma access key para ele.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua-access-key
AWS_SECRET_ACCESS_KEY=sua-secret-key
AWS_S3_BUCKET=nome-do-seu-bucket

# Amazon SES (envio de emails)
# O usuario IAM precisa da permissao ses:SendEmail. O remetente (ou o dominio dele)
# precisa estar verificado no SES. Em sandbox, os destinatarios tambem precisam.
# AWS_SES_REGION e opcional: se vazio, usa AWS_REGION.
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=nao-responda@seudominio.com
